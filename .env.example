# Local development origin. Use the same primary HTTPS origin for all three on production.
SITE_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# Required for provider-backed runtime and migrations; never expose in client code.
DATABASE_URL=
DATABASE_URL_MIGRATIONS=
BETTER_AUTH_SECRET=
ADMIN_EMAIL=admin@example.com
COMMENT_EMAIL_ENCRYPTION_KEY=

# Set only behind your trusted reverse proxy. Vercel uses its platform-owned IP header.
TRUST_PROXY=false
# Bootstrap only: supply OSBLOG_ADMIN_PASSWORD via process env, then remove it.
# Generate BETTER_AUTH_SECRET with >=32 random characters and COMMENT_EMAIL_ENCRYPTION_KEY
# as exactly 32 random bytes encoded in base64. Never put either under a VITE_ prefix.
