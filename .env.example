# Browser-safe build values may use VITE_ prefixes. Server secrets must not.
VITE_SITE_URL=https://example.invalid

# Required for provider-backed runtime and migrations; never expose in client code.
DATABASE_URL=
DATABASE_URL_MIGRATIONS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://example.invalid
ADMIN_EMAIL=admin@example.invalid
COMMENT_EMAIL_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
